{
  "extends": ["config:base"],
  "automerge": true,
  "automergeType": "pr",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["cocoapods", "swift"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ],
  "labels": ["dependencies"],
  "rebaseWhen": "behind-base-branch"
}

